{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,

    "outDir": "./dist",
    "types": [
      "node",
      "mocha"
    ]
  },

  "include": [
    "./hardhat.config.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
    "./ignition/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "cache"
  ]
}